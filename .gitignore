*.py[cod]
.venv/
venv/
.pytest_cache/

# Generated: recreate with `python -m kmz_points.cli --make-samples samples/`
samples/
*.xlsx

# setuptools, generated by `pip install -e .`
*.egg-info/

# PyInstaller
build/
dist/
staging/
*.dmg
# Specs are generated by default, but build.spec is hand-written and the
# build in CI and BUILDING.md depends on it.
*.spec
!build.spec

# Regenerated from the Python implementation on every test run. Committing it
# would let the browser version be checked against a stale reference, which is
# the one failure this cross-check exists to prevent.
web/test/fixtures.json

# macOS Finder metadata, created just by opening a folder in the GUI.
.DS_Store
